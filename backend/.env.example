# Copy to backend/.env (git-ignored) and fill in. Values here override nothing that is already
# set as a real environment variable.
#
# Supabase: Project → Connect → "Session pooler". Copy host, port and user from there; the
# password is the database password you chose when creating the project.
DB_URL=jdbc:postgresql://aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require
DB_USER=postgres.your-project-ref
DB_PASSWORD=your-database-password

# Optional
# DB_SCHEMA=scems
# DB_POOL_SIZE=5
# SEED_DEMO_DATA=true
